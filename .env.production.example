# =============================================================================
# PRODUCTION ENVIRONMENT — copy to .env.production and fill Atlas credentials
# =============================================================================
# NEVER commit .env.production (listed in .gitignore)

# --- MongoDB Atlas (REQUIRED for cloud) --------------------------------------
# Create cluster at https://cloud.mongodb.com → Database → Connect → Drivers
# Replace <user>, <password>, and <cluster> with your Atlas values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_inventory?retryWrites=true&w=majority
MONGODB_DB_NAME=smart_inventory

# --- Auth (generate new values; examples below are placeholders) ---------------
JWT_SECRET=GENERATE_WITH_python_-c_import_secrets_secrets.token_urlsafe_64
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
DEMO_ADMIN_EMAIL=admin@inventory.com
DEMO_ADMIN_PASSWORD=GENERATE_STRONG_PASSWORD_MIN_16_CHARS
DEMO_ADMIN_NAME=Inventory Admin

# --- CORS — comma-separated frontend URLs (no trailing slash) ----------------
# Local Docker:  http://localhost
# Render:        https://smart-inventory-dashboard.onrender.com
# Custom domain: https://yourdomain.com
CORS_ORIGINS=http://localhost,https://smart-inventory-dashboard.onrender.com

# --- Runtime -----------------------------------------------------------------
DEBUG=false
SEED_DEMO_DATA=false
SEED_DEMO_ADMIN=true
